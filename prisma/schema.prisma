/// Contextual supplier role; the registration remains the sole legal identity.
model TransportSupplierProfile {
  fleetOwnerships      TransportFleetOwnership[]
  registrationId       String                     @id @map("registration_id") @db.Uuid
  companyId            String                     @map("company_id") @db.Uuid
  active               Boolean                    @default(true)
  version              Int                        @default(1)
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  cnpj                 String                     @db.VarChar(14)
  legalName            String                     @map("legal_name") @db.VarChar(160)
  tradeName            String?                    @map("trade_name") @db.VarChar(120)
  legacyRegistrationId String?                    @unique @map("legacy_registration_id") @db.Uuid
  legacyRegistration   RoutingCompany?            @relation(fields: [legacyRegistrationId, companyId], references: [id, companyId], onDelete: Restrict, map: "transport_supplier_profiles_legacy_registration_fkey")
  tenant               Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  fleet                TransportFleet[]
  affiliations         TransportAffiliation[]
  contracts            TransportContractProfile[]

  @@unique([registrationId, companyId])
  @@unique([companyId, cnpj])
  @@unique([legacyRegistrationId, companyId], map: "transport_supplier_profiles_legacy_tenant_key")
  @@index([companyId, active])
  @@map("transport_supplier_profiles")
}

model TransportCatalogItem {
