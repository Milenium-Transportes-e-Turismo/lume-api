  @@map("transport_external_routes")
}

model TransportRouteAssignment {
  id         String                   @id @default(uuid()) @db.Uuid
  companyId  String                   @map("company_id") @db.Uuid
  routeId    String                   @map("route_id") @db.Uuid
  contractId String                   @map("contract_id") @db.Uuid
  validFrom  DateTime                 @map("valid_from") @db.Date
  validUntil DateTime?                @map("valid_until") @db.Date
  version    Int                      @default(1)
  route      TransportExternalRoute   @relation(fields: [routeId, companyId], references: [id, companyId], onDelete: Restrict)
  contract   TransportContractProfile @relation(fields: [contractId, companyId], references: [contractId, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@index([companyId, routeId, validFrom])
  @@index([companyId, contractId, validFrom])
  @@map("transport_route_assignments")
}

/// Atomic idempotency receipt and original response for catalog commands.
model TransportCatalogCommand {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  commandId   String   @map("command_id") @db.Uuid
  requestHash String   @map("request_hash") @db.VarChar(64)
  response    Json     @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, commandId])
  @@map("transport_catalog_commands")
}

model TransportIntegration {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  provider         String    @default("avic") @db.VarChar(40)
  enabled          Boolean   @default(false)
  settings         Json      @default("{}") @db.JsonB
  version          Int       @default(1)
  leaseUntil       DateTime? @map("lease_until") @db.Timestamptz(3)
  lastScheduledDay String?   @map("last_scheduled_day") @db.VarChar(10)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  company          Company   @relation(fields: [companyId], references: [id], onDelete: NoAction)

  @@unique([companyId, provider])
  @@map("transport_integrations")
}

model TransportImport {
  supersededByImportId String?                    @map("superseded_by_import_id") @db.Uuid
  supersededBy         TransportImport?           @relation("TransportImportSupersession", fields: [supersededByImportId, companyId], references: [id, companyId], onDelete: NoAction, onUpdate: NoAction, map: "transport_imports_superseded_tenant_fkey")
  supersededImports    TransportImport[]          @relation("TransportImportSupersession")
  rejected             Int                        @default(0)
  rejections           TransportImportRejection[]
  id                   String                     @id @default(uuid()) @db.Uuid
  companyId            String                     @map("company_id") @db.Uuid
  provider             String                     @default("avic") @db.VarChar(40)
  from                 DateTime                   @db.Date
  to                   DateTime                   @db.Date
  vehicleIds           String[]                   @map("vehicle_ids")
  vehicleIndex         Int                        @default(0) @map("vehicle_index")
  skip                 Int                        @default(0)
  imported             Int                        @default(0)
  status               String                     @default("QUEUED") @db.VarChar(20)
  lastError            String?                    @map("last_error") @db.VarChar(500)
  nextAttemptAt        DateTime                   @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  attemptCount         Int                        @default(0) @map("attempt_count")
  version              Int                        @default(1)
  scheduleKey          String?                    @map("schedule_key") @db.VarChar(160)
  verificationIssueId  String?                    @map("verification_issue_id") @db.Uuid
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  company              Company                    @relation(fields: [companyId], references: [id], onDelete: NoAction)

  @@unique([id, companyId])
  @@unique([companyId, provider, scheduleKey])
  @@index([companyId, status, nextAttemptAt])
  @@map("transport_imports")
}

model TransportRecord {
  driverExternalId   String?                  @map("driver_external_id") @db.VarChar(160)
  driverName         String?                  @map("driver_name") @db.VarChar(200)
  customerExternalId String?                  @map("customer_external_id") @db.VarChar(160)
  customerName       String?                  @map("customer_name") @db.VarChar(200)
  id                 String                   @id @default(uuid()) @db.Uuid
  companyId          String                   @map("company_id") @db.Uuid
  provider           String                   @default("avic") @db.VarChar(40)
  externalId         String                   @map("external_id") @db.VarChar(160)
  vehicleExternalId  String                   @map("vehicle_external_id") @db.VarChar(160)
  fleet              String?                  @db.VarChar(160)
  routeExternalId    String?                  @map("route_external_id") @db.VarChar(160)
  routeName          String?                  @map("route_name") @db.VarChar(1000)
  startedAt          DateTime?                @map("started_at") @db.Timestamptz(3)
  endedAt            DateTime?                @map("ended_at") @db.Timestamptz(3)
  sortAt             DateTime                 @map("sort_at") @db.Timestamptz(3)
  startKm            Decimal?                 @map("start_km") @db.Decimal(16, 3)
  endKm              Decimal?                 @map("end_km") @db.Decimal(16, 3)
  reportedKm         Decimal?                 @map("reported_km") @db.Decimal(16, 3)
  serviceKm          Decimal?                 @map("service_km") @db.Decimal(16, 3)
  source             String                   @default("DRIVER_REPORTED") @db.VarChar(30)
  sourceUpdatedAt    DateTime?                @map("source_updated_at") @db.Timestamptz(3)
  raw                Json                     @db.JsonB
  fingerprint        String                   @db.VarChar(64)
  version            Int                      @default(1)
  verifiedAt         DateTime                 @default(now()) @map("verified_at") @db.Timestamptz(3)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  company            Company                  @relation(fields: [companyId], references: [id], onDelete: NoAction)
  history            TransportRecordHistory[]
  issues             TransportIssue[]

  @@unique([id, companyId])
  @@unique([companyId, provider, externalId])
  @@index([companyId, provider, vehicleExternalId, sortAt, id])
  @@index([companyId, provider, routeExternalId, sortAt])
  @@index([companyId, vehicleExternalId, sortAt, id], map: "transport_record_vehicle_sequence_idx")
  @@index([companyId, sortAt, id], map: "transport_record_date_idx")
  @@map("transport_records")
}

model TransportRecordHistory {
  id        String          @id @default(uuid()) @db.Uuid
  companyId String          @map("company_id") @db.Uuid
  recordId  String          @map("record_id") @db.Uuid
  version   Int
  before    Json?           @db.JsonB
  after     Json            @db.JsonB
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  record    TransportRecord @relation(fields: [recordId, companyId], references: [id, companyId], onDelete: NoAction)

  @@unique([companyId, recordId, version])
  @@map("transport_record_history")
}

model TransportIssue {
  verificationUnavailableAt DateTime?               @map("verification_unavailable_at") @db.Timestamptz(3)
  id                        String                  @id @default(uuid()) @db.Uuid
  companyId                 String                  @map("company_id") @db.Uuid
  provider                  String                  @default("avic") @db.VarChar(40)
  recordId                  String                  @map("record_id") @db.Uuid
  vehicleExternalId         String                  @map("vehicle_external_id") @db.VarChar(160)
  code                      String                  @db.VarChar(80)
  status                    String                  @default("OPEN") @db.VarChar(20)
  verificationState         String                  @default("PENDING") @map("verification_state") @db.VarChar(20)
  context                   Json                    @default("{}") @db.JsonB
  guidance                  String                  @default("Corrija a quilometragem no sistema Avic. O Lume verificará novamente a origem e manterá o histórico.") @db.VarChar(500)
  version                   Int                     @default(1)
  detectedAt                DateTime                @default(now()) @map("detected_at") @db.Timestamptz(3)
  lastVerifiedAt            DateTime?               @map("last_verified_at") @db.Timestamptz(3)
  nextVerificationAt        DateTime                @default(now()) @map("next_verification_at") @db.Timestamptz(3)
  createdAt                 DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  record                    TransportRecord         @relation(fields: [recordId, companyId], references: [id, companyId], onDelete: NoAction)
  history                   TransportIssueHistory[]

  @@unique([id, companyId])
  @@unique([companyId, provider, recordId, code])
  @@index([companyId, status, nextVerificationAt])
  @@index([companyId, vehicleExternalId, status, id])
  @@index([companyId, status, id], map: "transport_issue_status_page_idx")
  @@map("transport_issues")
}

model TransportIssueHistory {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String         @map("company_id") @db.Uuid
  issueId     String         @map("issue_id") @db.Uuid
  kind        String         @db.VarChar(40)
  actorUserId String?        @map("actor_user_id") @db.Uuid
  before      Json?          @db.JsonB
  after       Json?          @db.JsonB
  text        String?        @db.VarChar(4000)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  issue       TransportIssue @relation(fields: [issueId, companyId], references: [id, companyId], onDelete: NoAction)

  @@index([companyId, issueId, createdAt])
  @@map("transport_issue_history")
}

model TransportAnalysis {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  vehicleId String    @map("vehicle_id") @db.VarChar(160)
  from      DateTime  @db.Date
  to        DateTime  @db.Date
  status    String    @default("QUEUED") @db.VarChar(20)
  cursorAt  DateTime? @map("cursor_at") @db.Timestamptz(3)
  cursorId  String?   @map("cursor_id") @db.Uuid
  processed Int       @default(0)
  lastError String?   @map("last_error") @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: NoAction)

  @@unique([id, companyId])
  @@index([companyId, status, createdAt])
  @@map("transport_analyses")
}

model TransportImportCommand {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  commandId   String   @map("command_id") @db.Uuid
  fingerprint String   @db.VarChar(64)
  result      Json     @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: NoAction)

  @@unique([companyId, commandId])
  @@map("transport_import_commands")
}

/// Time bounded ownership; imported records resolve by date instead of current fleet configuration.
model TransportFleetOwnership {
  id                     String                   @id @default(uuid()) @db.Uuid
  companyId              String                   @map("company_id") @db.Uuid
  fleetId                String                   @map("fleet_id") @db.Uuid
  supplierRegistrationId String                   @map("supplier_registration_id") @db.Uuid
  validFrom              DateTime                 @map("valid_from") @db.Date
  validUntil             DateTime?                @map("valid_until") @db.Date
  version                Int                      @default(1)
  fleet                  TransportFleet           @relation(fields: [fleetId, companyId], references: [id, companyId], onDelete: Restrict)
  supplier               TransportSupplierProfile @relation(fields: [supplierRegistrationId, companyId], references: [registrationId, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@index([companyId, fleetId, validFrom])
  @@map("transport_fleet_ownerships")
}

model TransportPeriodState {
  id         String          @id @default(uuid()) @db.Uuid
  companyId  String          @map("company_id") @db.Uuid
  contractId String          @map("contract_id") @db.Uuid
  period     String          @db.VarChar(10)
  state      String          @default("OPEN") @db.VarChar(16)
  version    Int             @default(1)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  contract   RoutingContract @relation(fields: [contractId, companyId], references: [id, companyId], onDelete: NoAction)

  @@unique([companyId, contractId, period])
  @@map("transport_period_states")
}

model TransportImportRejection {
  id           String          @id @default(uuid()) @db.Uuid
  companyId    String          @map("company_id") @db.Uuid
  importId     String          @map("import_id") @db.Uuid
  vehicleIndex Int             @map("vehicle_index")
  pageSkip     Int             @map("page_skip")
  position     Int
  raw          Json            @db.JsonB
  reason       String          @db.VarChar(400)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  batch        TransportImport @relation(fields: [importId, companyId], references: [id, companyId], onDelete: NoAction)

  @@unique([importId, vehicleIndex, pageSkip, position])
  @@index([companyId, importId, id])
  @@map("transport_import_rejections")
}
