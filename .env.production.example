# ============================================================================
# PRODUÇÃO — modelo para cofre/secret manager, não para commit de valores reais
# Todos os itens marcados como segredo devem ser gerados por ambiente.
# O schema usa development e porta 3000 apenas quando ausentes; produção deve
# declarar NODE_ENV=production e a porta operacional explicitamente.
# ============================================================================
NODE_ENV=production
PORT=3333
TENANT_API_PUBLIC_URL=https://api.cliente.example/api/v1

# ----------------------------------------------------------------------------
# POSTGRESQL — obrigatório
# POSTGRES_PASSWORD e DATABASE_URL são segredos. Codifique caracteres especiais
# da senha na URL. O banco deve ter backup e restauração testados.
# TEST_DATABASE_URL não pertence ao ambiente de produção.
# ----------------------------------------------------------------------------
POSTGRES_DB=lume_tenant
POSTGRES_USER=lume
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://lume:replace-with-url-encoded-password@postgres:5432/lume_tenant?schema=public
DATABASE_TRANSACTION_MAX_WAIT_MS=15000
DATABASE_TRANSACTION_TIMEOUT_MS=60000

# ----------------------------------------------------------------------------
# NÚCLEO DE ROTEIRIZAÇÃO — obrigatório para calcular rotas
# HEIGIT_API_KEY é segredo e deve permanecer somente na Tenant API.
# ----------------------------------------------------------------------------
HEIGIT_BASE_URL=https://api.heigit.org
HEIGIT_API_KEY=replace-with-heigit-api-key
ROUTING_TIMEOUT_MS=15000
ORS_VERSION=
ORS_MAP_DATA_VERSION=
TOLL_MATCH_CORRIDOR_METERS=60
TOLL_ALLOW_DEVELOPMENT_FIXTURES=false

# Pesquisa assistida opcional. Mantenha false até instalar uma chave exclusiva
# e validar consumo, logs e resultados no staging.
TOLL_INTELLIGENCE_ENABLED=false
TOLL_INTELLIGENCE_OPENAI_API_KEY=
TOLL_INTELLIGENCE_OPENAI_BASE_URL=https://api.openai.com/v1
TOLL_INTELLIGENCE_OPENAI_MODEL=gpt-5.4-mini
TOLL_INTELLIGENCE_TIMEOUT_MS=90000

# Runtime dos agentes Lume. Guarde uma chave OpenAI individual por agente no
# secret manager/Docker secret e persista apenas sua referência server-side.
# Não existe chave/modelo global nem fallback entre agentes.
AGENT_OPENAI_RESPONSES_TIMEOUT_MS=30000
LUME_AGENT_ORCHESTRATOR_OPENAI_API_KEY=replace-with-orchestrator-openai-key
LUME_AGENT_CUSTOMER_SERVICE_OPENAI_API_KEY=replace-with-customer-service-openai-key
LUME_AGENT_REGISTRATION_OPENAI_API_KEY=replace-with-registration-openai-key
LUME_AGENT_KNOWLEDGE_OPENAI_API_KEY=replace-with-knowledge-openai-key
LUME_AGENT_MEDIA_OPENAI_API_KEY=replace-with-media-openai-key
LUME_AGENT_CONTINUITY_OPENAI_API_KEY=replace-with-continuity-openai-key
LUME_AGENT_SUPERVISOR_OPENAI_API_KEY=replace-with-supervisor-openai-key

# ----------------------------------------------------------------------------
# PRISMA STUDIO — bloqueado por padrão
# Não mantenha essas flags ativas. Para uma janela autorizada, confirme
# exatamente "host/banco" em PRISMA_STUDIO_CONFIRM_TARGET.
# ----------------------------------------------------------------------------
PRISMA_STUDIO_PORT=5555
PRISMA_STUDIO_ALLOW_REMOTE=false
PRISMA_STUDIO_ALLOW_PRODUCTION=false
PRISMA_STUDIO_CONFIRM_TARGET=

# ----------------------------------------------------------------------------
# AUTENTICAÇÃO — JWT_ACCESS_SECRET é obrigatório e secreto
# ----------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
JWT_REFRESH_REMEMBER_TTL_DAYS=30
BCRYPT_ROUNDS=12
PASSWORD_CHANGE_TOKEN_TTL_MINUTES=30
PASSWORD_HISTORY_LIMIT=10
PASSWORD_RESET_URL_BASE=https://app.cliente.example/reset-password
PASSWORD_RESET_MIN_RESPONSE_MS=750

# ----------------------------------------------------------------------------
# E-MAIL/RESEND — obrigatório para recuperação e suporte em produção
# Use chave restrita a Sending e domínio verificado com SPF/DKIM.
# ----------------------------------------------------------------------------
EMAIL_DELIVERY_ENABLED=true
RESEND_API_KEY=replace-with-resend-sending-api-key
RESEND_FROM_EMAIL=no-reply@cliente.example
RESEND_FROM_NAME=Lume
RESEND_API_URL=https://api.resend.com
RESEND_REQUEST_TIMEOUT_MS=10000
RESEND_MAX_ATTEMPTS=2
RESEND_RETRY_DELAY_MS=150
SUPPORT_RECIPIENT_EMAIL=devops@mileniumturismo.com.br
SUPPORT_CC_EMAIL=taiane.karine@mileniumturismo.com.br,taianekas.dev@outlook.com

# ----------------------------------------------------------------------------
# DOMÍNIOS, TLS E PROXY — obrigatórios
# TLS termina no proxy reverso. Não use "*" em CORS_ORIGINS.
# ----------------------------------------------------------------------------
CORS_ORIGINS=https://app.cliente.example
SWAGGER_ENABLED=false
TRUST_PROXY_HOPS=1
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
HTTP_MAX_JSON_BODY_BYTES=1048576
# Metadados de uso do painel administrativo. Não armazena corpos nem arquivos.
API_USAGE_RETENTION_DAYS=90

# ----------------------------------------------------------------------------
# WHATSAPP — obrigatório para o MVP comercial
# IDs e números não são segredos, mas devem corresponder ao bootstrap.
# ----------------------------------------------------------------------------
WHATSAPP_ENABLED=true
# Atualize no momento da ativação. Eventos anteriores são concluídos sem envio.
WHATSAPP_AUTOMATION_ACTIVE_SINCE=
WHATSAPP_API_DISPATCH_INTERVAL_MS=500
WHATSAPP_API_REQUEST_TIMEOUT_MS=10000
WHATSAPP_API_EXECUTION_TIMEOUT_MS=480000
WHATSAPP_API_DISPATCH_BATCH_SIZE=20
WHATSAPP_API_RETRY_BASE_DELAY_MS=500
WHATSAPP_API_RETRY_MAX_DELAY_MS=300000
WHATSAPP_API_DEBOUNCE_MS=2000
WHATSAPP_API_DEPARTMENT_COLLECTION_MS=120000
WHATSAPP_CHANNEL_ID=replace-with-stable-channel-uuid
WHATSAPP_CHANNEL_NAME=WhatsApp principal
WHATSAPP_PHONE_NUMBER=5511999999999
WHATSAPP_IGNORE_GROUPS=true
WHATSAPP_IGNORE_FROM_ME=true
WHATSAPP_MAX_WEBHOOK_BYTES=262144
WHATSAPP_MAX_ATTACHMENT_BYTES=52428800
WHATSAPP_PANEL_MAX_ATTACHMENT_BYTES=104857600
WHATSAPP_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/zip,application/x-zip-compressed,application/vnd.rar,application/x-rar,application/x-rar-compressed,application/x-7z-compressed,text/plain,text/csv,text/vcard,text/x-vcard,application/octet-stream,audio/ogg,audio/mpeg,audio/mp4,audio/aac,audio/wav,video/mp4,video/webm,video/quicktime
WHATSAPP_MEDIA_STORAGE_DRIVER=filesystem
# Obrigatório, absoluto e montado em volume persistente com backup.
WHATSAPP_MEDIA_STORAGE_PATH=/app/var/whatsapp-media
KNOWLEDGE_STORAGE_DRIVER=filesystem
# Obrigatório, absoluto, privado e montado em volume persistente com backup.
KNOWLEDGE_STORAGE_PATH=/app/var/knowledge
WHATSAPP_IMPORT_ROOT=/app/var/imports/whatsapp
# Obrigatório para backups Android grandes; diretório privado no mesmo volume.
WHATSAPP_IMPORT_UPLOAD_TEMP_ROOT=/app/var/imports/whatsapp/incoming
WHATSAPP_ANDROID_BACKUP_MAX_DECRYPTED_BYTES=4294967296
WHATSAPP_ANDROID_BACKUP_UPLOAD_CHUNK_BYTES=16777216
WHATSAPP_ANDROID_IMPORT_CHUNK_MESSAGES=25000
WHATSAPP_IMPORT_APPLY_CONCURRENCY=4
WHATSAPP_ANDROID_MEDIA_MAX_FILE_BYTES=536870912
WHATSAPP_ANDROID_MEDIA_ARCHIVE_MAX_BYTES=8589934592
WHATSAPP_ANDROID_MEDIA_ARCHIVE_MAX_ENTRIES=250000
WHATSAPP_ANDROID_MEDIA_ARCHIVE_MAX_UNCOMPRESSED_BYTES=17179869184
WHATSAPP_ANDROID_MEDIA_ARCHIVE_CONCURRENCY=4
WHATSAPP_ANDROID_MEDIA_UPLOAD_CHUNK_BYTES=16777216
WHATSAPP_HISTORY_IMPORT_MAX_ARCHIVES=5000
WHATSAPP_HISTORY_IMPORT_MAX_ARCHIVE_BYTES=536870912
WHATSAPP_HISTORY_IMPORT_MAX_ENTRIES=5000
WHATSAPP_HISTORY_IMPORT_MAX_UNCOMPRESSED_BYTES=2147483648
WHATSAPP_HISTORY_IMPORT_MAX_TEXT_BYTES=134217728
WHATSAPP_HISTORY_IMPORT_RETENTION_HOURS=48
WHATSAPP_HISTORY_IMPORT_LEASE_SECONDS=900
WHATSAPP_HISTORY_IMPORT_RECOVERY_INTERVAL_SECONDS=15
WHATSAPP_HISTORY_IMPORT_CLEANUP_INTERVAL_MINUTES=15
WHATSAPP_HISTORY_IMPORT_MAX_ACTIVE_BATCHES_PER_TENANT=2
WHATSAPP_HISTORY_IMPORT_MAX_TEMPORARY_BYTES_PER_TENANT=17179869184
WHATSAPP_RETENTION_DAYS=365
WHATSAPP_FOLLOW_UP_INACTIVITY_MS=1800000
WHATSAPP_PREVENT_CLOSE_WITH_APPROVED_QUOTE=false
INTEGRATION_RETENTION_DAYS=90
RETENTION_JOB_ENABLED=true

# ----------------------------------------------------------------------------
# EVOLUTION API — obrigatório; API key e webhook secret são segredos
# ----------------------------------------------------------------------------
EVOLUTION_PROVIDER_NAME=Evolution API
EVOLUTION_BASE_URL=https://evolution.cliente.example
EVOLUTION_INSTANCE_NAME=lume-production
EVOLUTION_API_KEY=replace-with-evolution-api-key
EVOLUTION_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
EVOLUTION_SEND_TEXT_PAYLOAD_MODE=number-text
EVOLUTION_SEND_TEXT_TIMEOUT_MS=10000
EVOLUTION_SEND_MEDIA_TIMEOUT_MS=30000
EVOLUTION_MANAGEMENT_TIMEOUT_MS=15000
EVOLUTION_MEDIA_CONTENT_TIMEOUT_MS=30000
EVOLUTION_PROFILE_PICTURE_TIMEOUT_MS=5000
EVOLUTION_PROFILE_PICTURE_CACHE_TTL_MS=3600000
WEBHOOK_MAX_SKEW_MS=300000
WEBHOOK_MAX_EVENT_AGE_MS=604800000
EVOLUTION_DISPATCH_LEASE_MS=90000

# ----------------------------------------------------------------------------
# AUTOMAÇÃO WHATSAPP LEGADA — somente conversas históricas já em estados de menu.
# Novos atendimentos usam exclusivamente os runtimes individuais LUME_AGENT_*.
# OpenAI é o adapter ativo hoje; providers futuros entram pelo registry.
# ----------------------------------------------------------------------------
WHATSAPP_AI_PROVIDER_ORDER=openai
WHATSAPP_AI_REQUEST_TIMEOUT_MS=90000
WHATSAPP_AI_OPENAI_API_KEY=
WHATSAPP_AI_OPENAI_BASE_URL=https://api.openai.com/v1
WHATSAPP_AI_OPENAI_MODEL=gpt-5.5
# Mensagens recebidas destes números internos são ignoradas pelo webhook.
MILENIUM_DIRECTOR_PHONE=replace-with-director-phone
MILENIUM_DEPARTMENT_PURCHASES_PHONE=replace-with-purchases-phone
MILENIUM_DEPARTMENT_CONTROLLING_PHONE=replace-with-controlling-phone
MILENIUM_DEPARTMENT_DP_PHONE=replace-with-personnel-department-phone
MILENIUM_DEPARTMENT_FINANCE_PHONE=replace-with-finance-phone
MILENIUM_DEPARTMENT_MANAGEMENT_PHONE=replace-with-management-phone
MILENIUM_DEPARTMENT_MAINTENANCE_PHONE=replace-with-maintenance-phone
MILENIUM_DEPARTMENT_MONITORING_PHONE=replace-with-monitoring-phone
MILENIUM_DEPARTMENT_OPERATIONAL_PHONE=replace-with-operations-phone

# ----------------------------------------------------------------------------
# INTERCÂMBIO DE ARQUIVOS — obrigatório se o módulo for disponibilizado
# A quota é por tenant e inclui uploads e conversões ainda não expirados.
# ----------------------------------------------------------------------------
DATA_EXCHANGE_MAX_FILE_BYTES=26214400
DATA_EXCHANGE_MAX_TENANT_BYTES=262144000
DATA_EXCHANGE_RETENTION_DAYS=30

# ----------------------------------------------------------------------------
# REVISÃO DOCUMENTAL — habilite somente após configurar a chave no servidor.
# ----------------------------------------------------------------------------
DOCUMENT_REVIEW_ENABLED=false
DOCUMENT_REVIEW_PROVIDER=local
OPENAI_API_KEY=
OPENAI_DOCUMENT_MODEL=gpt-5.6-terra
OPENAI_DOCUMENT_TIMEOUT_MS=90000
OPENAI_DOCUMENT_MAX_ATTEMPTS=3
OPENAI_API_BASE_URL=https://api.openai.com/v1

# ----------------------------------------------------------------------------
# LICENÇA OFFLINE — obrigatória e fornecida pelo Lume Control
# LICENSE_DOCUMENT é secreto.
# ----------------------------------------------------------------------------
INSTALLATION_ID=replace-with-control-installation-uuid
LICENSE_PUBLIC_KEY_BASE64=replace-with-control-ed25519-public-key-base64
LICENSE_DOCUMENT=replace-with-signed-offline-license

# ----------------------------------------------------------------------------
# BOOTSTRAP INICIAL — preencher somente na primeira instalação
# Depois do bootstrap, remova TENANT_ADMIN_PASSWORD do ambiente.
# ----------------------------------------------------------------------------
TENANT_LEGAL_NAME=
TENANT_TRADE_NAME=
TENANT_TAX_ID=
TENANT_ADMIN_NAME=
TENANT_ADMIN_USERNAME=
TENANT_ADMIN_EMAIL=
TENANT_ADMIN_CPF=
TENANT_ADMIN_PASSWORD=

# Transportes / Avic: opcionais, somente servidor. Desativado ate confirmar contrato.
TRANSPORT_WORKER_ENABLED=false
# URL da API de dados; login no Swagger nao autentica a API.
AVIC_API_BASE_URL=http://avicsistemas.avicddns.com.br:8669/
# Login automatico servidor-servidor: preencha ambos; nunca NEXT_PUBLIC.
# SECRETO: usuario da API de dados Avic (UserID), nao da documentacao Swagger.
AVIC_API_USER_ID=
# SECRETO: chave de acesso da API de dados Avic (AccessKey).
AVIC_API_ACCESS_KEY=
# Opcional: deixe vazio para JWT com exp. So preencher apos confirmar fuso da
# Expiration sem fuso, caso o provedor passe a emitir token opaco (ex.: -03:00).
AVIC_AUTH_UTC_OFFSET=
# Opcional/SECRETO: headers adicionais ou modo estatico legado.
# No login automatico, deixe vazio; Authorization aqui causa conflito de config.
AVIC_API_HEADERS_JSON=

# Optional: one reminder after 3h waiting on customer, close 1h after it is sent.
# Human/commercial pending work is excluded.
WHATSAPP_CUSTOMER_REMINDER_DELAY_MS=10800000
WHATSAPP_CUSTOMER_CLOSURE_DELAY_MS=3600000
